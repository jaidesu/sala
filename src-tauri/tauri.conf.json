{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sala",
  "version": "0.1.0",
  "identifier": "app.sala.chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sala",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sala",
    "homepage": "https://github.com/jaidesu/sala",
    "category": "SocialNetworking",
    "shortDescription": "Chat privado, direto entre computadores",
    "longDescription": "Chat peer-to-peer privado, sem servidor central e sem cadastro. Quem cria a sala hospeda a conversa no próprio computador; os convidados entram com um convite e uma senha. Todo o tráfego é cifrado de ponta a ponta.",
    "copyright": "© 2026 Sala",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
